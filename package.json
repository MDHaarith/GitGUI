{
  "name": "gitgui",
  "private": true,
  "version": "0.12.0",
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/version.mjs --check",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "node --test src/*.test.ts",
    "preversion": "npm test",
    "version": "node scripts/version.mjs",
    "version:check": "node scripts/version.mjs --check",
    "tauri": "tauri",
    "prepare": "git config core.hooksPath .githooks",
    "install:app": "sh scripts/install.sh",
    "test:ui": "node --test tests/ui.test.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.2",
    "@tauri-apps/plugin-dialog": "2.8.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.1",
    "playwright-core": "1.64.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
